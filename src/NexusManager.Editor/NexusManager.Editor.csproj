<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>nexus-manager-editor</AssemblyName>
    <RootNamespace>NexusManager.Editor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- Circular colour picker (ColorSpectrum Shape=Ring). Not in core Avalonia. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NexusManager.Render/NexusManager.Render.csproj" />
    <ProjectReference Include="../NexusManager.Device/NexusManager.Device.csproj" />
    <ProjectReference Include="../NexusManager.Sensors/NexusManager.Sensors.csproj" />
  </ItemGroup>
</Project>
