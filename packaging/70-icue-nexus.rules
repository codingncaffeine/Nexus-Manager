# Corsair iCUE NEXUS companion touchscreen (1b1c:1b8e)
#
# MUST sort below 73. /usr/lib/udev/rules.d/73-seat-late.rules is what turns
# TAG=="uaccess" into an ACL (RUN{builtin}+="uaccess"), and udev evaluates rule
# files in lexical order — a rule numbered 99 applies the tag AFTER the consumer
# has already run, so it grants nothing while looking perfectly correct.
#
# uaccess gives an ACL to the active local seat's user only, which is why it is
# preferred over MODE="0666" (world read/write).
KERNEL=="hidraw*", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1b8e", TAG+="uaccess"
