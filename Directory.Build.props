<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Standing rule: "0 Errors, N Warnings" is not green. Warnings fail the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Single source of truth for the shipped version. packaging/build-release.sh
         reads VersionPrefix out of this file, so the tag, the .deb metadata, the
         tarball name and the PKGBUILD cannot drift apart from the binaries. -->
    <VersionPrefix>0.0.6</VersionPrefix>

    <!-- ⛔ Without this every assembly embeds the ABSOLUTE path it was built
         from - the .pdb reference alone leaks the developer's username and
         directory layout into a public binary, and it turns up in any stack
         trace a user pastes into a bug report. PathMap rewrites the compiler's
         idea of the source root, so paths ship as /nexus-manager/... instead.
         It is also what makes the build deterministic: without it, the same
         source built in two directories produces different binaries. -->
    <PathMap>$(MSBuildThisFileDirectory)=/nexus-manager/</PathMap>
    <Deterministic>true</Deterministic>
    <!-- Unconditional, not CI-only. Making it conditional meant CI and a
         workstation produced DIFFERENT binaries from the same commit by
         design, which defeats the point of a reproducible build. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
